# ==========================================
# IG PIPELINE ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Gemini AI API Key (Pre-configured)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Telegram Bot Configuration (For prompts & approvals)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 3. Instagram & Cloudinary Publishing (For final posting)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
IG_USER_ID=your_instagram_user_id_here
IG_ACCESS_TOKEN=your_instagram_long_lived_access_token_here

# 4. Optional Image Providers
POLLINATIONS_API_KEY=
